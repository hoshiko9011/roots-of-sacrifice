# Returns the chapter with the requested stable ID, or an empty dictionary when absent.
static func chapter_by_id(id: int) -> Dictionary:
	for chapter in CHAPTERS:
		if chapter.get("id", -1) == id:
			return chapter
	return {}


# Collects every quiz question assigned to one chapter in content order.
static func questions_for_chapter(id: int) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for question in QUESTIONS:
		if question.get("chapter", -1) == id:
			result.append(question)
	return result


# Returns the plant definition matching an ID, or an empty dictionary for unknown species.
static func species_by_id(id: String) -> Dictionary:
	for species in SPECIES:
		if species.get("id", "") == id:
			return species
	return {}

# Lists NPC indices that participate in the chapter story sequence.
static func npc_story_npcs() -> Array[int]:
	return [0, 1, 2, 3]

# Resolves one chapter story by NPC and one-based chapter number.
static func npc_story(npc_index: int, chapter: int) -> Dictionary:
	var stories: Array = NPC_STORIES.get(npc_index, [])
	var index := chapter - 1
	if index < 0 or index >= stories.size():
		return {}
	return stories[index]

# Counts all available NPC stories for completion tracking.
static func npc_story_total() -> int:
	var total := 0
	for npc_index in npc_story_npcs():
		total += NPC_STORIES.get(npc_index, []).size()
	return total
